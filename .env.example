# Supabase – required for auth and database
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Solana RPC – defaults to devnet if not set
# Use a private RPC (e.g. Helius, QuickNode) to avoid public rate limits.
VITE_SOLANA_RPC_URL="https://api.devnet.solana.com"

# Pinata (IPFS) – required for token metadata uploads (server-side, api/upload-ipfs.js)
PINATA_API_KEY="your-pinata-api-key"
PINATA_SECRET_KEY="your-pinata-secret-key"

# Gemini AI – required for AI features (server-side, api/gemini.js)
# Set this in Vercel Environment Variables — never expose in frontend code.
GEMINI_API_KEY="your-gemini-api-key"
